---
import 'maplibre-gl/dist/maplibre-gl.css';
import 'maplibre-gl-draw/dist/mapbox-gl-draw.css';
---

<div class="relative w-full h-[600px] rounded-xl overflow-hidden shadow-inner border border-slate-200">
  <div id="map" class="w-full h-full"></div>

  <!-- Submission Modal Overlay -->
  <div id="submission-modal" class="hidden absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 z-50 w-full max-w-md px-4">
    <div class="bg-white p-6 rounded-xl shadow-2xl w-full border border-slate-200">
      <h3 class="text-xl font-bold mb-4">Share your feedback</h3>
      <p class="text-sm text-slate-600 mb-4">How do you feel about this spot/route?</p>
      
      <div class="flex justify-between gap-2 mb-4" id="emoji-selector">
        <button type="button" class="text-3xl p-2 rounded hover:bg-slate-100 transition-colors" data-emoji="😊">😊</button>
        <button type="button" class="text-3xl p-2 rounded hover:bg-slate-100 transition-colors" data-emoji="😕">😕</button>
        <button type="button" class="text-3xl p-2 rounded hover:bg-slate-100 transition-colors" data-emoji="😢">😢</button>
        <button type="button" class="text-3xl p-2 rounded hover:bg-slate-100 transition-colors" data-emoji="😠">😠</button>
      </div>
      
      <input type="hidden" id="selected-emoji" value="" />

      <label class="block text-sm font-medium text-slate-700 mb-1">Comment (optional)</label>
      <textarea id="comment-input" class="w-full border border-slate-300 rounded p-2 mb-4 h-24" placeholder="What's going on here?"></textarea>

      <div class="flex justify-end gap-2">
        <button id="cancel-btn" class="px-4 py-2 rounded text-slate-600 hover:bg-slate-100 font-medium">Cancel</button>
        <button id="submit-btn" class="px-4 py-2 rounded bg-blue-600 text-white hover:bg-blue-700 font-medium disabled:opacity-50" disabled>Submit</button>
      </div>
    </div>
  </div>
</div>

<script>
  import * as maplibregl from 'maplibre-gl';
  import MapboxDraw from 'maplibre-gl-draw';
  import { supabase } from '../lib/supabase';

  let currentFeature: any = null;

  // Initialize Map
  const map = new maplibregl.Map({
    container: 'map',
    style: 'https://basemaps.cartocdn.com/gl/positron-gl-style/style.json',
    center: [-71.1448, 42.3539], // Centered roughly on Allston-Brighton
    zoom: 14,
    minZoom: 13, // Prevent zooming out to the city/state level
    maxBounds: [
      [-71.180, 42.330], // Southwest boundary (Newton/Brookline border)
      [-71.100, 42.370]  // Northeast boundary (Charles River/BU Bridge)
    ]
  });

  // Initialize Drawing plugin
  const draw = new MapboxDraw({
    displayControlsDefault: false,
    controls: {
      point: true,
      line_string: true,
      trash: true
    }
  });

  map.addControl(draw as unknown as maplibregl.IControl);

  // Identity management
  function getOrCreateUserIdentifier() {
    let id = localStorage.getItem('ab_user_id');
    if (!id) {
      id = 'user_' + Math.random().toString(36).substring(2, 11);
      localStorage.setItem('ab_user_id', id);
    }
    return id;
  }

  // Handle data loading
  async function loadMapData() {
    const { data, error } = await supabase.from('map_submissions').select('*');
    if (error) {
      console.error('Error fetching map data:', error);
      return;
    }

    // Helper to fill in solid lines on the heatmap
    function interpolateLine(coords: number[][]) {
      const points = [];
      for (let i = 0; i < coords.length - 1; i++) {
        const start = coords[i];
        const end = coords[i + 1];
        
        // Approximate distance in degrees
        const dx = end[0] - start[0];
        const dy = end[1] - start[1];
        const dist = Math.sqrt(dx * dx + dy * dy);
        
        // Insert a point every ~10 meters (0.0001 degrees)
        const steps = Math.max(1, Math.floor(dist / 0.0001));
        
        for (let j = 0; j <= steps; j++) {
          const fraction = j / steps;
          points.push([
            start[0] + dx * fraction,
            start[1] + dy * fraction
          ]);
        }
      }
      return points;
    }

    const heatmapFeatures: GeoJSON.Feature[] = [];
    
    // Convert all submissions (including lines) into dense points for the heatmap
    data.forEach(row => {
      const feature = row.geo_data;
      if (feature.geometry.type === 'Point') {
        heatmapFeatures.push({
          type: 'Feature',
          geometry: feature.geometry,
          properties: { 
            weight: 0.3,
            sentiment: row.sentiment
          }
        });
      } else if (feature.geometry.type === 'LineString') {
        const densePoints = interpolateLine(feature.geometry.coordinates);
        densePoints.forEach(coord => {
          heatmapFeatures.push({
            type: 'Feature',
            geometry: { type: 'Point', coordinates: coord },
            properties: { 
              weight: 0.1,
              sentiment: row.sentiment
            }
          });
        });
      }
    });

    const geoJson: GeoJSON.FeatureCollection = {
      type: 'FeatureCollection',
      features: heatmapFeatures
    };

    const source = map.getSource('submissions') as maplibregl.GeoJSONSource;
    if (source) {
      source.setData(geoJson);
    } else {
      map.addSource('submissions', {
        type: 'geojson',
        data: geoJson
      });

      // Positive Heatmap (Green)
      map.addLayer({
        id: 'submissions-heat-positive',
        type: 'heatmap',
        source: 'submissions',
        maxzoom: 22,
        filter: ['==', ['get', 'sentiment'], '😊'],
        paint: {
          'heatmap-weight': ['get', 'weight'],
          'heatmap-intensity': [
            'interpolate', ['linear'], ['zoom'],
            13, 0.4,
            15, 0.8,
            20, 2.5
          ],
          'heatmap-color': [
            'interpolate', ['linear'], ['heatmap-density'],
            0, 'rgba(34, 197, 94, 0)',
            0.2, 'rgba(34, 197, 94, 0.2)',
            0.5, 'rgba(34, 197, 94, 0.6)',
            0.8, 'rgba(21, 128, 61, 0.8)',
            1, 'rgba(20, 83, 45, 1)'
          ],
          'heatmap-radius': [
            'interpolate', ['linear'], ['zoom'],
            13, 15,
            15, 30,
            20, 120
          ],
          'heatmap-opacity': 0.7
        }
      });

      // Negative Heatmap (Red)
      map.addLayer({
        id: 'submissions-heat-negative',
        type: 'heatmap',
        source: 'submissions',
        maxzoom: 22,
        filter: ['!=', ['get', 'sentiment'], '😊'],
        paint: {
          'heatmap-weight': ['get', 'weight'],
          'heatmap-intensity': [
            'interpolate', ['linear'], ['zoom'],
            13, 0.4,
            15, 0.8,
            20, 2.5
          ],
          'heatmap-color': [
            'interpolate', ['linear'], ['heatmap-density'],
            0, 'rgba(239, 68, 68, 0)',
            0.2, 'rgba(239, 68, 68, 0.2)',
            0.5, 'rgba(239, 68, 68, 0.6)',
            0.8, 'rgba(185, 28, 28, 0.8)',
            1, 'rgba(127, 29, 29, 1)'
          ],
          'heatmap-radius': [
            'interpolate', ['linear'], ['zoom'],
            13, 15,
            15, 30,
            20, 120
          ],
          'heatmap-opacity': 0.7
        }
      });
    }
  }

  map.on('load', () => {
    loadMapData();
  });

  // UI Elements
  const modal = document.getElementById('submission-modal');
  const emojiBtns = document.querySelectorAll('#emoji-selector button');
  const selectedEmojiInput = document.getElementById('selected-emoji') as HTMLInputElement;
  const commentInput = document.getElementById('comment-input') as HTMLTextAreaElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const cancelBtn = document.getElementById('cancel-btn') as HTMLButtonElement;

  // Force single-segment lines
  map.on('click', () => {
    setTimeout(() => {
      if (draw.getMode() === 'draw_line_string') {
        const features = draw.getAll().features;
        const activeLines = features.filter((f: any) => f.geometry.type === 'LineString');
        
        if (activeLines.length > 0) {
          const currentLine = activeLines[activeLines.length - 1];
          // MapboxDraw adds a moving cursor point, so 3 coordinates = 2 clicked points
          if (currentLine && (currentLine.geometry as GeoJSON.LineString).coordinates.length >= 3) {
            draw.changeMode('simple_select', { featureIds: [currentLine.id as string] });
          }
        }
      }
    }, 10);
  });

  // Handle drawing creation
  map.on('draw.create' as any, (e: any) => {
    currentFeature = e.features[0];
    if (modal) modal.classList.remove('hidden');
  });

  // Handle emoji selection
  emojiBtns.forEach(btn => {
    btn.addEventListener('click', (e) => {
      // Reset styles
      emojiBtns.forEach(b => b.classList.remove('bg-blue-100', 'ring', 'ring-blue-500'));
      // Set active style
      const target = e.currentTarget as HTMLButtonElement;
      target.classList.add('bg-blue-100', 'ring', 'ring-blue-500');
      // Set value
      selectedEmojiInput.value = target.dataset.emoji || '';
      submitBtn.disabled = false;
    });
  });

  // Handle cancel
  cancelBtn?.addEventListener('click', () => {
    if (currentFeature) {
      draw.delete(currentFeature.id);
      currentFeature = null;
    }
    closeModal();
  });

  // Handle submit
  submitBtn?.addEventListener('click', async () => {
    if (!currentFeature || !selectedEmojiInput.value) return;

    submitBtn.disabled = true;
    submitBtn.textContent = "Saving...";

    const { error } = await supabase.from('map_submissions').insert({
      geo_data: currentFeature,
      sentiment: selectedEmojiInput.value,
      comment: commentInput.value,
      user_identifier: getOrCreateUserIdentifier()
    });

    if (error) {
      alert("Error saving submission: " + error.message);
      console.error(error);
    } else {
      // Clean up drawing state
      draw.delete(currentFeature.id);
      currentFeature = null;
      loadMapData(); // Refresh data
    }
    
    closeModal();
  });

  function closeModal() {
    if (modal) modal.classList.add('hidden');
    selectedEmojiInput.value = '';
    commentInput.value = '';
    submitBtn.disabled = true;
    submitBtn.textContent = "Submit";
    emojiBtns.forEach(b => b.classList.remove('bg-blue-100', 'ring', 'ring-blue-500'));
  }

  // End of script
</script>
