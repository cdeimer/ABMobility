---
import { SEO } from "astro-seo";
import "../styles/global.css";
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <SEO
      title="Allston-Brighton Active Streets"
      description="Safe streets, vibrant spaces, connected community. A grassroots transportation advocacy project for Allston-Brighton."
      openGraph={{
        basic: {
          title: "Allston-Brighton Active Streets",
          type: "website",
          image: "/og-image.png",
        },
      }}
      twitter={{
        card: "summary_large_image",
        title: "Allston-Brighton Active Streets",
        description:
          "Safe streets, vibrant spaces, connected community. A grassroots transportation advocacy project for Allston-Brighton.",
        image: "/og-image.png",
      }}
    />
  </head>
  <body
    class="min-h-screen flex flex-col bg-dot-pattern text-slate-900 font-sans"
  >
    <main class="flex-grow max-w-5xl mx-auto px-4 py-8 w-full space-y-16">
      <slot />
    </main>

    <footer class="bg-white border-t border-slate-200 mt-auto">
      <div
        class="max-w-5xl mx-auto px-4 py-6 flex flex-wrap items-center justify-center gap-3 text-center text-sm text-slate-500"
      >
        <p>
          A community-driven transportation advocacy project for
          Allston-Brighton in Boston
        </p>
        <span class="hidden sm:inline text-slate-300">&bull;</span>
        <div class="flex items-center gap-4">
          <a
            href="https://github.com/cdeimer/ABMobility"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub Repository"
            class="text-slate-400 hover:text-black transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="w-5 h-5"
              ><path
                d="M15 22v-4a4.8 4.8 0 0 0-1-3.02c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"
              ></path></svg
            >
          </a>
          <a
            href="https://instagram.com/allstonbrighton.bike"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram Account"
            class="text-slate-400 hover:text-black transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="w-5 h-5"
              ><rect width="20" height="20" x="2" y="2" rx="5" ry="5"
              ></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"
              ></path><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line></svg
            >
          </a>
        </div>
      </div>
    </footer>
  </body>
</html>
