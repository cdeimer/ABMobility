---
import '../styles/global.css';
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Allston-Brighton Mobility</title>
	</head>
	<body class="min-h-screen flex flex-col bg-slate-50 text-slate-900">
		<header class="bg-white border-b border-slate-200 sticky top-0 z-50">
			<div class="max-w-5xl mx-auto px-4 py-4 flex flex-col sm:flex-row justify-between items-center">
				<a href="#" class="text-xl font-bold">AB Mobility</a>
				<nav class="mt-4 sm:mt-0 space-x-6 text-sm font-medium">
					<a href="#map" class="hover:text-blue-600 transition-colors">Sentiment Map</a>
					<a href="#action" class="hover:text-blue-600 transition-colors">Take Action</a>
					<a href="#events" class="hover:text-blue-600 transition-colors">Events</a>
				</nav>
			</div>
		</header>

		<main class="flex-grow max-w-5xl mx-auto px-4 py-8 w-full space-y-16">
			<slot />
		</main>

		<footer class="bg-white border-t border-slate-200 mt-auto">
			<div class="max-w-5xl mx-auto px-4 py-6 text-center text-sm text-slate-500">
				<p>A community-driven transportation advocacy project for Allston-Brighton, Boston.</p>
			</div>
		</footer>
	</body>
</html>
