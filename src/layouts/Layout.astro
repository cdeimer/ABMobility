---
import { SEO } from "astro-seo";
import "../styles/global.css";
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <SEO
      title="Allston-Brighton Mobility Hub"
      description="Safe streets, vibrant spaces, connected community. A grassroots transportation advocacy project for Allston-Brighton."
      openGraph={{
        basic: {
          title: "Allston-Brighton Mobility Hub",
          type: "website",
          image: "/og-image.png",
        },
      }}
      twitter={{
        card: "summary_large_image",
        title: "Allston-Brighton Mobility Hub",
        description:
          "Safe streets, vibrant spaces, connected community. A grassroots transportation advocacy project for Allston-Brighton.",
        image: "/og-image.png",
      }}
    />
  </head>
  <body
    class="min-h-screen flex flex-col bg-dot-pattern text-slate-900 font-sans"
  >
    <main class="flex-grow max-w-5xl mx-auto px-4 py-8 w-full space-y-16">
      <slot />
    </main>

    <footer class="bg-white border-t border-slate-200 mt-auto">
      <div
        class="max-w-5xl mx-auto px-4 py-6 text-center text-sm text-slate-500"
      >
        <p>
          A community-driven transportation advocacy project for
          Allston-Brighton in Boston.
        </p>
      </div>
    </footer>
  </body>
</html>
