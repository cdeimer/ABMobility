---
import Layout from "../layouts/Layout.astro";
import Map from "../components/Map.astro";

interface Campaign {
  frontmatter: {
    title: string;
    deadline?: string;
    target_emails: string;
    email_subject: string;
    email_body: string;
  };
  Content: any;
}

// Fetch all campaigns from markdown files
const campaigns = Object.values(
  import.meta.glob<Campaign>("../content/campaigns/*.md", { eager: true }),
);
---

<Layout>
  <!-- Hero Section -->
  <section class="neo-brutalist bg-[#ffe4e6] p-8 md:p-12 mb-16 rotate-1 relative mt-8">
    <div class="text-center">
      <h1 class="text-5xl md:text-7xl font-extrabold mb-6 uppercase tracking-tight font-mono text-black leading-tight">
        Allston-Brighton<br/>Active Streets
      </h1>
      <p class="text-2xl font-bold text-black max-w-2xl mx-auto bg-[#fef08a] inline-block px-4 py-2 border-2 border-black -rotate-1 mb-6">
        Safer streets, vibrant spaces, a connected community
      </p>
      <p class="text-lg text-black max-w-2xl mx-auto mt-4 mb-8 font-medium bg-white p-4 border-2 border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">
        We are a grassroots, community-driven movement working to radically improve walking, rolling, biking, and transit in our neighborhood. Get involved, share your voice, and help us transform our streets!
      </p>
      
      <div class="flex flex-wrap justify-center gap-6 mt-8">
        <a href="#map" class="neo-brutalist-interactive bg-[#bfdbfe] px-6 py-3 text-xl font-bold uppercase -rotate-2">
          🗺️ Sentiment Map
        </a>
        <a href="#action" class="neo-brutalist-interactive bg-[#bbf7d0] px-6 py-3 text-xl font-bold uppercase rotate-1">
          ✊ Take Action
        </a>
        <a href="#events" class="neo-brutalist-interactive bg-[#fbcfe8] px-6 py-3 text-xl font-bold uppercase -rotate-1">
          📅 Events
        </a>
      </div>
    </div>
  </section>

  <!-- Interactive Map Section -->
  <section id="map" class="scroll-mt-24 mb-16">
    <div class="mb-8 text-center">
      <h2 class="text-4xl font-extrabold font-mono uppercase bg-[#bfdbfe] inline-block px-4 py-2 border-4 border-black rotate-1 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">Sentiment Map</h2>
      <p class="text-xl font-bold mt-4 text-black bg-white inline-block px-4 py-2 border-2 border-black -rotate-2">
        Use the tools on the map to drop a pin or draw a line highlighting areas that need improvement or are working well.
      </p>
    </div>
    
    <div class="neo-brutalist bg-slate-100 overflow-hidden">
      <Map />
    </div>
  </section>

  <!-- Take Action Section -->
  <section id="action" class="scroll-mt-24 mb-16">
    <div class="mb-8 text-center">
      <h2 class="text-4xl font-extrabold font-mono uppercase bg-[#bbf7d0] inline-block px-4 py-2 border-4 border-black rotate-2 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">Take Action</h2>
      <p class="text-xl font-bold mt-4 text-black bg-white inline-block px-4 py-2 border-2 border-black -rotate-1">
        Make your voice heard. Send emails to local officials regarding these ongoing campaigns.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {
        campaigns.map((campaign, index) => {
          const Content = campaign.Content;
          return (
          <div class="neo-brutalist p-6 bg-white flex flex-col">
            <h3 class="text-2xl font-extrabold mb-3 font-mono uppercase border-b-2 border-black pb-2">{campaign.frontmatter.title}</h3>
            <div class="diy-prose mb-6 grow text-lg font-medium text-black">
              <Content />
            </div>

            {campaign.frontmatter.deadline && (
              <p class="text-lg font-bold bg-[#fecaca] inline-block self-start px-2 py-1 border-2 border-black mb-6">
                🚨 Deadline: {campaign.frontmatter.deadline}
              </p>
            )}

            <div class="mt-auto flex flex-col gap-3 border-t-4 border-black pt-6">
              <!-- To Field -->
              <div class="bg-black text-white p-3 md:p-4 relative shadow-[4px_4px_0px_0px_rgba(0,0,0,0.3)]">
                <div class="flex flex-col sm:flex-row gap-1 sm:gap-3">
                  <div class="text-sm font-bold text-[#39ff14] uppercase tracking-wide font-mono shrink-0 sm:w-24 pt-1 sm:pt-0.5">To:</div>
                  <div class="font-mono text-sm whitespace-pre-wrap break-words pt-0.5 grow">{campaign.frontmatter.target_emails}</div>
                </div>
                <button 
                  class="copy-btn absolute top-3 right-3 md:top-4 md:right-4 w-[72px] bg-black text-[#39ff14] border-2 border-[#39ff14] py-1 text-center font-bold text-xs uppercase hover:bg-[#39ff14] hover:text-black transition-colors"
                  data-copy={campaign.frontmatter.target_emails}
                >
                  Copy
                </button>
              </div>

              <!-- Subject Field -->
              <div class="bg-black text-white p-3 md:p-4 relative shadow-[4px_4px_0px_0px_rgba(0,0,0,0.3)]">
                <div class="flex flex-col sm:flex-row gap-1 sm:gap-3">
                  <div class="text-sm font-bold text-[#39ff14] uppercase tracking-wide font-mono shrink-0 sm:w-24 pt-1 sm:pt-0.5">Subject:</div>
                  <div class="font-mono text-sm whitespace-pre-wrap break-words pt-0.5 grow">{campaign.frontmatter.email_subject}</div>
                </div>
                <button 
                  class="copy-btn absolute top-3 right-3 md:top-4 md:right-4 w-[72px] bg-black text-[#39ff14] border-2 border-[#39ff14] py-1 text-center font-bold text-xs uppercase hover:bg-[#39ff14] hover:text-black transition-colors"
                  data-copy={campaign.frontmatter.email_subject}
                >
                  Copy
                </button>
              </div>

              <!-- Message Field -->
              <div class="bg-black text-white p-3 md:p-4 relative shadow-[4px_4px_0px_0px_rgba(0,0,0,0.3)] mt-1">
                <div class="flex flex-col sm:flex-row gap-1 sm:gap-3">
                  <div class="text-sm font-bold text-[#39ff14] uppercase tracking-wide font-mono shrink-0 sm:w-24 pt-1 sm:pt-0.5">Message:</div>
                  <div class="font-mono text-sm whitespace-pre-wrap break-words pt-0.5 grow">{campaign.frontmatter.email_body}</div>
                </div>
                <button 
                  class="copy-btn absolute top-3 right-3 md:top-4 md:right-4 w-[72px] bg-black text-[#39ff14] border-2 border-[#39ff14] py-1 text-center font-bold text-xs uppercase hover:bg-[#39ff14] hover:text-black transition-colors"
                  data-copy={campaign.frontmatter.email_body}
                >
                  Copy
                </button>
              </div>
            </div>
          </div>
        )})
      }
    </div>
  </section>

  <!-- Events Section -->
  <section id="events" class="scroll-mt-24 mb-16">
    <div class="mb-8 text-center">
      <h2 class="text-4xl font-extrabold font-mono uppercase bg-[#fbcfe8] inline-block px-4 py-2 border-4 border-black -rotate-2 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">Upcoming Events</h2>
      <p class="text-xl font-bold mt-4 text-black bg-white inline-block px-4 py-2 border-2 border-black rotate-1">
        Join community meetings, group rides, and neighborhood walks.
      </p>
    </div>

    <div class="space-y-6">
      <div class="neo-brutalist bg-[#fef08a] p-6 flex flex-col sm:flex-row sm:items-center justify-between rotate-1 hover:rotate-0 transition-transform">
        <div>
          <h3 class="text-2xl font-extrabold font-mono uppercase mb-2">
            Allston Civic Association Monthly Meeting
          </h3>
          <p class="text-black text-lg font-medium bg-white inline-block px-2 py-1 border-2 border-black">
            <span class="font-bold">Date:</span> September 10, 2026 @ 6:00 PM <br />
            <span class="font-bold">Location:</span> Honan-Allston Library / Zoom
          </p>
        </div>
        <a href="#" class="neo-brutalist-interactive mt-6 sm:mt-0 bg-white border-2 border-black px-4 py-2 font-bold uppercase text-center self-start sm:self-auto">
          RSVP & Details &rarr;
        </a>
      </div>

      <div class="neo-brutalist bg-[#bfdbfe] p-6 flex flex-col sm:flex-row sm:items-center justify-between -rotate-1 hover:rotate-0 transition-transform">
        <div>
          <h3 class="text-2xl font-extrabold font-mono uppercase mb-2">
            Brighton Center Walk Audit
          </h3>
          <p class="text-black text-lg font-medium bg-white inline-block px-2 py-1 border-2 border-black">
            <span class="font-bold">Date:</span> September 15, 2026 @ 10:00 AM <br />
            <span class="font-bold">Location:</span> Meet at the Brighton Center intersection
          </p>
        </div>
        <a href="#" class="neo-brutalist-interactive mt-6 sm:mt-0 bg-white border-2 border-black px-4 py-2 font-bold uppercase text-center self-start sm:self-auto">
          RSVP & Details &rarr;
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  document.querySelectorAll('.copy-btn').forEach(button => {
    button.addEventListener('click', () => {
      const textToCopy = button.getAttribute('data-copy');
      if (textToCopy) {
        navigator.clipboard.writeText(textToCopy).then(() => {
          const originalText = button.textContent;
          button.textContent = 'Copied!';
          setTimeout(() => {
            button.textContent = originalText;
          }, 2000);
        });
      }
    });
  });
</script>
